# TapRide backend environment (copy to backend/.env, which is git-ignored)
#
# Preferred: a single SQLAlchemy URL. Passwords with special characters must be
# URL-encoded.
DATABASE_URL=postgresql+psycopg://tapride:change-me@localhost:5432/tapride

# Alternative: individual parts, used only when DATABASE_URL is empty.
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=tapride
# DB_USER=tapride
# DB_PASSWORD=change-me
# DB_SSLMODE=prefer

# Connection pool tuning (optional)
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
DB_CONNECT_TIMEOUT=5
DB_ECHO=false
